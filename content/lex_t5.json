  "azt": {"t": "то", "l": "az — то", "p": "az + -t (что?)", "w": "azt jelenti, hogy … = «означает то, что …». Указывает на продолжение после hogy.", "g": "G_ACC"},
  "betegjogok": {"t": "права пациентов", "l": "betegjog — право пациента", "p": "beteg (больной) + jog (право) + -ok (мн. число)", "w": "Одно слово: «больной-права». Права третьего поколения.", "g": "G_PL"},
