{
  "t5_fel": {"t": "(часть глагола fellép — выступать)", "l": "fel — приставка «вверх»", "w": "Приставка глагола fellép «выступать, выступить (за что-то)». В вопросе она оторвалась и стоит после глагола: léptek fel = выступали.", "g": "G_PREVERB"},
  "t5_ki": {"t": "(часть глагола kiad — издать)", "l": "ki — приставка «вы-, наружу»", "w": "Это не «кто»! Здесь ki — приставка глагола kiad «выпустить, издать». В вопросе она стоит после глагола: adták ki = издали.", "g": "G_PREVERB"},

  "adat": {"t": "данные", "l": "adat — данные, сведение", "w": "Как английское data. adatok = данные (мн. число)."},
  "adatok": {"t": "данных", "l": "adat — данные", "p": "adat + -ok (мн. число)", "w": "személyes adatok = «личные данные».", "g": "G_PL"},
  "adták": {"t": "издали (выпустили)", "l": "kiad — издать, выпустить", "p": "ad (давать) + -t- (прош.) + -ák (они, определ.)", "w": "adták ki = «издали». Приставка ki стоит после глагола.", "g": "G_PAST"},
  "adó": {"t": "налог", "l": "adó — налог", "w": "Буквально «даваемое»: ad = давать. На чеке увидишь ÁFA — налог на добавленную стоимость."},
  "adófizetés": {"t": "уплата налогов", "l": "adófizetés — уплата налогов", "p": "adó (налог) + fizetés (оплата)", "w": "Два слова склеены в одно: «налог-оплата»."},
  "alapjogok": {"t": "основных прав", "l": "alapjog — основное право", "p": "alap (основа) + jog (право) + -ok (мн. число)", "w": "Короткое слово для alapvető jogok — «основные права».", "g": "G_PL"},
  "alaptörvényben": {"t": "в Основном законе", "l": "Alaptörvény — Основной закон", "p": "Alaptörvény + -ben (в)", "w": "-ben = «в». Передние гласные (ö, é) → -ben, а не -ban.", "g": "G_LOC"},
