  "biztosának": {"t": "уполномоченного", "l": "biztos — уполномоченный", "p": "biztos + -a (его) + -nak", "w": "az alapvető jogok biztosának eljárását = «процедуру уполномоченного по основным правам». -nak здесь показывает владельца.", "g": "G_POSS"},
