  "alkotmánybíróságnak": {"t": "Конституционному суду", "l": "Alkotmánybíróság — Конституционный суд", "p": "Alkotmánybíróság + -nak (кому?)", "w": "-nak / -nek = «кому, чему»."},
  "alkotmányellenes": {"t": "неконституционный", "l": "alkotmányellenes — противоречащий конституции", "p": "alkotmány (конституция) + ellenes (против)", "w": "Дословно «конституции-противный»."},
  "alkotmányellenesnek": {"t": "неконституционной", "l": "alkotmányellenes — неконституционный", "p": "alkotmányellenes + -nek (кем/чем признать)", "w": "С глаголом nyilvánít «объявить» окончание -nek показывает, кем или чем объявили: alkotmányellenesnek nyilvánította = «объявил неконституционной»."},
  "andrás": {"t": "Андраш (король Андраш II)", "l": "András — мужское имя (Андрей)", "w": "II. András — венгерский король, в 1222 году выпустил Золотую буллу. Читается «АН-драш»: s = ш."},
  "angol": {"t": "английская", "l": "angol — английский; англичанин", "w": "Прилагательное не меняется: angol dokumentum = английский документ."},
  "aranybulla": {"t": "Золотая булла", "l": "Aranybulla — Золотая булла (1222)", "p": "arany (золото) + bulla (булла, печатная грамота)", "w": "Венгерская грамота короля Андраша II, 1222 год. «Золотая» из-за золотой печати."},
  "aranybullát": {"t": "Золотую буллу", "l": "Aranybulla — Золотая булла", "p": "Aranybulla + -t (что?)", "w": "Конечная a удлиняется в á перед -t: bulla → bullát.", "g": "G_ACC"},
