  "alatt": {"t": "под", "l": "alatt — под (послелог)", "w": "Стоит ПОСЛЕ слова: a joghatóságuk alatt = «под их юрисдикцией».", "g": "G_LOC"},
  "alkotmány": {"t": "конституция", "l": "alkotmány — конституция", "w": "От alkot — создавать. «То, что создаёт государство»."},
